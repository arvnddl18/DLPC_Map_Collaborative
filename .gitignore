# ==============================================================================
# Security & Environment Protection (.gitignore)
# DLPC_Map_Collaborative - Davao Light and Power Company
# ==============================================================================

# Environment variable files and secrets
.env
.env.*
!.env.example
!.env.test.example
*.env
*.env.local

# Credentials, keys, certificates, and tokens
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12
*.jks
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.token
credentials.json
service-account*.json
secrets/

# Database files and dumps
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.sql.gz
*.dump
dump.rdb

# Large raw telecom datasets, facility reports, and spreadsheets
NAP Facility Summary Report-06-05-2026 14-39.csv
NAP Facility Summary Report*.csv
Book1.xlsx
*.xlsx
*.xls
*.csv

# Node.js and dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build outputs and distribution directories
dist/
build/
out/
.next/
.nuxt/
.output/
.turbo/
.cache/

# Testing and Playwright artifacts
test-results/
playwright-report/
blob-report/
playwright/.cache/
coverage/
.nyc_output/

# Logs and runtime data
logs/
*.log
scratch/
tmp/
temp/

# IDE, Editor, and OS sensitive files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.sublime-project
*.sublime-workspace

# Keep VS Code MCP and settings, but ignore local session/history
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json

# Local backup and temporary files
*.bak
*.orig
*.rej
