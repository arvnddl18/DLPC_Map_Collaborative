# ==============================================================================
# Environment Configuration Template (.env.example)
# Project: DLPC_Map_Collaborative (Davao Light and Power Company)
# ==============================================================================
# IMPORTANT:
# - Copy this file to '.env' and fill in secure values for your local environment.
# - NEVER commit '.env' or real credentials to source control.
# - Production environments should inject secrets via a secure secrets manager.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
APP_URL=http://localhost:3000

# Authentication & Session Security
# Generate secure keys using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_base64_string_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace_with_another_secure_random_base64_string_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d
SESSION_COOKIE_SECRET=replace_with_secure_cookie_encryption_key_min_32_chars

# CORS Allowed Origins (Comma-separated exact URLs, no trailing slashes or wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Database & Geospatial Connection (PostGIS / PostgreSQL)
# Ensure the database user has least-privilege permissions
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dlpc_map_dev
DB_USER=dlpc_map_user
DB_PASSWORD=replace_with_strong_database_password
DB_SSL_MODE=require
DB_POOL_MIN=2
DB_POOL_MAX=10

# Spatial Mapping & Vector Tile Services
# Public tokens must be scoped with domain/URL restrictions in provider dashboards
MAPBOX_ACCESS_TOKEN=pk.replace_with_domain_restricted_public_mapbox_token
GIS_TILE_SERVER_URL=https://tiles.dlpc.internal/v1

# Real-Time WebSocket & Collaboration
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_CONNECTIONS_PER_IP=10

# Rate Limiting & Abuse Prevention
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# Logging & Telemetry
LOG_LEVEL=info
ENABLE_DEBUG_LOGS=false
